RewriteEngine On
RewriteRule ([^/]+)/(\d\d\d\d)/(.*)  /$2/$3   [R]

RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule (.*) /%1 [R=302,L]

# Jekyll wrote each post as <slug>.html and MultiViews served the extensionless
# URL directly. Hugo writes <slug>/index.html instead, so serve that internally
# rather than letting mod_dir 301 every legacy inbound link to a trailing slash.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+[^/])$ /$1/index.html [L]

RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html

# Jekyll's paginate-v2 emitted /page2, /page3...; the home page no longer
# paginates at all -- it shows the most recent handful and points at the
# archive, which is where twenty years of posts now live.
RewriteRule ^page(\d+)/?$ /archive/ [R=301,L]

Options +MultiViews
